<!DOCTYPE html>
<html lang="ja">
<head>
  <meta charset="utf-8">
  <title>読みたい本の一覧</title>
</head>
<body>
  <h2>読みたい本の一覧</h2>
  <table border="1">
    <tr><th>ID</th><th>本のタイトル</th><th>著者</th></tr>
    <% for (let row of data) { %>
      <tr><td><%= row.id %></td><td><%= row.title %></td><td><%= row.author %></td></tr>
    <% } %>
  </table>
  <p><a href="/public/books_add.html">本を追加する</a></p>
</body>
</html>
