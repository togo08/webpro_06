<!DOCTYPE html>
<html lang="ja">
<head>
  <meta charset="utf-8">
  <title>駅の削除確認</title>
</head>
<body>
  <h2>駅の削除確認</h2>
  <p><%= data.name %>（<%= data.code %>）を削除しますか？</p>
  <form action="/keiyo2/delete/<%= id %>" method="get">
    <input type="hidden" name="id" value="<%= data.id %>">
    <input type="submit" value="この駅を削除する">
  </form>
  <p><a href="/keiyo2/<%= id %>">キャンセル</a></p>
</body>
</html>
