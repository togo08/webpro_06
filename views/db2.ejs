<!DOCTYPE html>
<html lang="ja">
<head>
  <meta charset="utf-8">
  <title>京葉線の駅</title>
</head>
<body>
  <h2>京葉線の駅</h2>
  <table border="1">
    <tr><th>ID</th><th>駅コード</th><th>駅名</th></tr>
    <% for (let row of data) { %>
      <tr><td><%= row.id %></td><td><%= row.code %></td><td><%= row.name %></td></tr>
    <% } %>
  </table>
  <p><a href="/public/keiyo_add.html">駅を追加する</a></p>
</body>
</html>
